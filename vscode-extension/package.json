{
  "name": "pawsoff-vscode",
  "displayName": "PawsOff",
  "description": "See what PawsOff did in each AI session, which files AI tools can't touch, and get a pop-up when it stops something.",
  "version": "0.1.0",
  "publisher": "pawsoff",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.pawsoff.yml",
    "workspaceContains:.pawsoff.yaml",
    "workspaceContains:.pawsoff.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pawsoff.openSessions",
        "title": "PawsOff: Show sessions"
      },
      {
        "command": "pawsoff.showRules",
        "title": "PawsOff: Show protected files"
      },
      {
        "command": "pawsoff.checkFile",
        "title": "PawsOff: Check this file"
      },
      {
        "command": "pawsoff.verifyLog",
        "title": "PawsOff: Verify edit log"
      },
      {
        "command": "pawsoff.init",
        "title": "PawsOff: Create policy and install Claude Code hooks"
      }
    ],
    "configuration": {
      "title": "PawsOff",
      "properties": {
        "pawsoff.popups": {
          "type": "string",
          "enum": [
            "important",
            "all",
            "off"
          ],
          "default": "important",
          "enumDescriptions": [
            "Pop up when PawsOff stops something or needs your approval",
            "Also pop up when values are swapped",
            "Never pop up"
          ],
          "description": "When PawsOff should pop up a notification."
        }
      }
    }
  }
}