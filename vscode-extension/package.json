{
  "name": "paws-vscode",
  "displayName": "Paws",
  "description": "See what Paws did in each AI session, which files AI tools can't touch, and get a pop-up when it stops something.",
  "version": "0.1.0",
  "publisher": "paws",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.paws.yml",
    "workspaceContains:.paws.yaml",
    "workspaceContains:.paws.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "paws.openSessions",
        "title": "Paws: Show sessions"
      },
      {
        "command": "paws.showRules",
        "title": "Paws: Show protected files"
      },
      {
        "command": "paws.checkFile",
        "title": "Paws: Check this file"
      },
      {
        "command": "paws.verifyLog",
        "title": "Paws: Verify edit log"
      },
      {
        "command": "paws.init",
        "title": "Paws: Create policy and install Claude Code hooks"
      }
    ],
    "configuration": {
      "title": "Paws",
      "properties": {
        "paws.popups": {
          "type": "string",
          "enum": [
            "important",
            "all",
            "off"
          ],
          "default": "important",
          "enumDescriptions": [
            "Pop up when Paws stops something or needs your approval",
            "Also pop up when values are swapped",
            "Never pop up"
          ],
          "description": "When Paws should pop up a notification."
        }
      }
    }
  }
}